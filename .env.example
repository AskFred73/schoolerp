# PostgreSQL (docker-compose defaults)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=school_erp;Username=schoolerp;Password=schoolerp_dev

# API JWT (change in production)
Jwt__Key=SchoolERP_Dev_Signing_Key_Change_In_Production_Min32Chars!
Jwt__Issuer=SchoolERP
Jwt__Audience=SchoolERP.Client

# Next.js client (copy to client/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5080
NEXT_PUBLIC_TENANT_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_CLASS_XA_ID=22222222-2222-2222-2222-222222222222

# Integration tests: set SCHOOLERP_USE_TESTCONTAINERS=1 when Docker is available
